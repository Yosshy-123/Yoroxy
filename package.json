{
  "name": "yoroxy",
  "private": true,
  "version": "1.0.0",
  "description": "Web Proxy",
  "type": "module",
  "engines": {
    "npm": ">=7.0.0",
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node test/run-all.mjs",
    "lint": "eslint .",
    "test:unit": "node --test test/specs/server/*.spec.mjs test/specs/static/*.spec.mjs test/specs/unit/*.spec.mjs test/specs/tab-history.spec.mjs",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "check": "npm run lint && npm run test:unit",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@tomphttp/bare-server-node": "2.0.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "pixelmatch": "^5.3.0",
    "playwright": "1.64.1",
    "pngjs": "^7.0.0"
  }
}
